{
  "test_name": "qwen35_13s8t_gpu090_dp_baseline_c12",
  "topology": "single_dp",
  "mode": "dp_baseline",
  "description": "Qwen3.5-4B DP=2, gpu-mem 0.9, Codex 13s8t (104 rows), no router, C12",
  "mark": [
    {
      "hardware_marks": {
        "res": {
          "gpu": "CUDA"
        },
        "num_cards": 2
      }
    }
  ],
  "serve_env": {
    "CUDA_VISIBLE_DEVICES": "0,1"
  },
  "server_params": {
    "model": "/path/to/Qwen3.5-4B",
    "middleware": [],
    "serve_args": {
      "host": "127.0.0.1",
      "port": 0,
      "served-model-name": "qwen-codex-c4-dp",
      "tensor-parallel-size": 1,
      "data-parallel-size": 2,
      "max-model-len": 131072,
      "gpu-memory-utilization": 0.9,
      "enable-prefix-caching": true,
      "trust-remote-code": true,
      "max-num-seqs": 12,
      "enable-prompt-tokens-details": true
    }
  },
  "result_root": "test-results/router-codex",
  "benchmark_params": {
    "sessions": 13,
    "turns": 8,
    "sample-order": "stratified_size",
    "num-prompts": 104,
    "max-concurrency": 12,
    "max-tokens": 256,
    "fire-mode": "session_serial",
    "trace-requests": false,
    "timeout": 7200
  },
  "assertions": {
    "max-failed-requests": 0,
    "min-successful-requests": 104
  }
}
